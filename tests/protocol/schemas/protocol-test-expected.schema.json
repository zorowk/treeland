{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treeland.deepin.org/schemas/protocol-test-expected.schema.json",
  "title": "Treeland protocol test expected result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case", "expectation_source", "checkpoints"],
  "properties": {
    "schema_version": { "const": 1 },
    "case": { "type": "string", "minLength": 1 },
    "expectation_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_by", "based_on", "xml_sha256", "server_commit", "review_status"],
      "properties": {
        "generated_by": { "type": "string", "minLength": 1 },
        "based_on": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "xml_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "server_commit": { "type": "string", "minLength": 1 },
        "review_status": { "enum": ["candidate", "human-reviewed"] }
      }
    },
    "checkpoints": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/checkpoint" }
    }
  },
  "$defs": {
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_events", "server_state"],
      "properties": {
        "client_events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["object", "event", "args"],
            "properties": {
              "object": { "type": "string", "minLength": 1 },
              "event": { "const": "show_desktop" },
              "args": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
            }
          }
        },
        "server_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["desktop_state", "desktop_state_changed_count"],
          "properties": {
            "desktop_state": { "type": "integer", "minimum": 0 },
            "desktop_state_changed_count": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
