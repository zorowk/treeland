{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treeland.deepin.org/schemas/protocol-test-input.schema.json",
  "title": "Treeland protocol test input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case", "protocol", "steps"],
  "properties": {
    "schema_version": { "const": 1 },
    "case": { "type": "string", "minLength": 1 },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface", "version"],
      "properties": {
        "interface": { "const": "treeland_window_management_v1" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/bind" },
          { "$ref": "#/$defs/request" },
          { "$ref": "#/$defs/clientRoundtrip" },
          { "$ref": "#/$defs/checkpoint" },
          { "$ref": "#/$defs/disconnect" }
        ]
      }
    }
  },
  "$defs": {
    "bind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bind"],
      "properties": {
        "bind": {
          "type": "object",
          "additionalProperties": false,
          "required": ["object", "interface", "version"],
          "properties": {
            "object": { "type": "string", "minLength": 1 },
            "interface": { "const": "treeland_window_management_v1" },
            "version": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request"],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["object", "name", "args"],
          "properties": {
            "object": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "args": { "type": "array" }
          }
        }
      }
    },
    "clientRoundtrip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_roundtrip"],
      "properties": {
        "client_roundtrip": { "type": "object", "maxProperties": 0 }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint"],
      "properties": { "checkpoint": { "type": "string", "minLength": 1 } }
    },
    "disconnect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disconnect"],
      "properties": { "disconnect": { "type": "object", "maxProperties": 0 } }
    }
  }
}
