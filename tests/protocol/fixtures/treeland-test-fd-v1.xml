<protocol name="treeland_test_fd_v1">
  <interface name="treeland_test_fd_v1" version="1">
    <description summary="fd argument protocol test fixture">
      Exercises Wayland fd request and event transport with dup() ownership.
    </description>
    <request name="echo">
      <arg name="value" type="fd"/>
    </request>
    <request name="destroy" type="destructor"/>
    <event name="value">
      <arg name="value" type="fd"/>
    </event>
  </interface>
</protocol>
