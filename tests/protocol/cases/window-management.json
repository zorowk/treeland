{
  "protocol": "treeland_window_management_v1",
  "description": "Window management protocol tests",
  "tests": [
    {
      "name": "set-desktop-show",
      "steps": [
        { "type": "request", "name": "set_desktop", "args": [1] },
        { "type": "roundtrip" },
        { "type": "checkpoint" }
      ],
      "expected": {
        "events": [
          { "event": "show_desktop", "args": [{ "type": "uint", "value": 1 }] }
        ]
      }
    },
    {
      "name": "set-desktop-normal",
      "steps": [
        { "type": "request", "name": "set_desktop", "args": [0] },
        { "type": "roundtrip" },
        { "type": "checkpoint" }
      ],
      "expected": {
        "events": [
          { "event": "show_desktop", "args": [{ "type": "uint", "value": 0 }] }
        ]
      }
    }
  ]
}
