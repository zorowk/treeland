{
  "xml_path": "/usr/share/treeland-protocols/treeland-wallpaper-color-v1.xml",
  "module": {
    "class": "WallpaperColorInterfaceV1",
    "header": "wallpapercolorinterfacev1.h",
    "dir": "wallpaper-color"
  },
  "description": "Wallpaper color monitoring",
  "tests": [
    {
      "name": "watch-triggers-output-color",
      "description": "XML: output_color sent immediately when client requests a watch",
      "steps": [
        {
          "type": "request",
          "name": "watch",
          "args": [
            "HEADLESS-1"
          ]
        },
        {
          "type": "roundtrip"
        },
        {
          "type": "checkpoint"
        }
      ],
      "expected": {
        "events": [
          {
            "event": "output_color",
            "args": [
              {
                "type": "string",
                "value": "HEADLESS-1"
              },
              {
                "type": "uint",
                "value": 0
              }
            ]
          }
        ]
      }
    }
  ]
}
