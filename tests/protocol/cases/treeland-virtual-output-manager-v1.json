{
  "protocol": "treeland_virtual-output-manager_v1",
  "xml_path": "/usr/share/treeland-protocols/treeland-virtual-output-manager-v1.xml",
  "module": {
    "class": "VirtualOutputManagerInterfaceV1",
    "header": "virtualoutputmanagerinterfacev1.h",
    "dir": "virtual-output"
  },
  "description": "Smoke test (needs headless output configuration)",
  "tests": [
    {
      "name": "smoke-create_virtual_output",
      "description": "Verifies client can bind, send create_virtual_output, and not crash. needs headless output configuration",
      "steps": [
        {
          "type": "request",
          "name": "create_virtual_output",
          "args": [
            "test-smoke",
            "hex:00"
          ]
        },
        {
          "type": "roundtrip"
        },
        {
          "type": "checkpoint"
        }
      ],
      "expected": {
        "events": [
          {
            "event": "treeland_virtual_output_v1.error",
            "args": [
              {
                "type": "uint",
                "value": 1
              },
              {
                "type": "string",
                "value": "The number of screens applying for copy mode is less than 2!"
              }
            ]
          }
        ]
      }
    }
  ]
}
