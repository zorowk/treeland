{
  "schema_version": 1,
  "case": "wine-window-management.set-position",
  "protocol": {
    "interface": "treeland_wine_window_manager_v1",
    "version": 1
  },
  "server": {
    "outputs": [
      { "name": "HEADLESS-1", "geometry": [0, 0, 1280, 720], "scale": 1 }
    ],
    "disable_animations": true
  },
  "client": {
    "objects": [
      {
        "name": "window",
        "fixture": "xdg_toplevel",
        "app_id": "test.wine.position",
        "size": [300, 200],
        "mapped": true
      },
      {
        "name": "control",
        "interface": "treeland_wine_window_control_v1",
        "for": "$window"
      }
    ]
  },
  "steps": [
    { "capture": { "name": "position_serial", "value": 7 } },
    {
      "request": {
        "object": "control",
        "name": "set_position",
        "args": [100, 120, "$position_serial"]
      }
    },
    { "barrier": { "type": "client_roundtrip" } },
    {
      "barrier": {
        "type": "server_condition",
        "probe": "surface.geometry",
        "selector": { "app_id": "test.wine.position" },
        "equals": [100, 120, 300, 200],
        "timeout_ms": 1000
      }
    },
    { "checkpoint": "position-applied" },
    { "destroy": { "objects": ["control", "manager"] } },
    { "disconnect": {} }
  ]
}
